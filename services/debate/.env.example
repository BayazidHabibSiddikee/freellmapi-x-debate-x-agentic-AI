# ===========================================
# AI Debate & Research Platform Configuration
# ===========================================

# ---- LLM Configuration --------------------
# FreeLLM API Server
OPENAI_API_BASE=http://localhost:3001/v1
OPENAI_API_KEY=(auto-discovered from server/data/freeapi.db, or set explicitly)

# LLM model to use
LLM_MODEL=gemini-3.5-flash

# ---- Server Configuration ----------------
FLASK_DEBUG=False
DEBATE_PORT=5050
RAG_SERVER_URL=http://localhost:5080
RAG_PORT=5080

# ---- Paths ----------------------------------
CHARACTER_IMAGES_DIR=images
STORAGE_DIR=storage

# ---- RAG Configuration ---------------------
EMBEDDING_MODEL=all-MiniLM-L6-v2
FAISS_INDEX_PATH=storage/faiss_db
DOC_DIR=doc
CODE_DIR=code

# ---- Logging --------------------------------
LOG_LEVEL=INFO
